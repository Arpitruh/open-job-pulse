{
  "name": "open-job-pulse",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "db:generate": "cd packages/db && npx prisma generate",
    "db:migrate": "cd packages/db && npx prisma migrate dev",
    "db:migrate:prod": "cd packages/db && npx prisma migrate deploy",
    "db:studio": "cd packages/db && npx prisma studio",
    "db:seed": "cd packages/db && npx ts-node prisma/seed.ts",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^6.15.0",
    "prettier": "^3.3.0",
    "turbo": "^2.3.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@tiptap/extension-placeholder": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "@xenova/transformers": "^1.4.3",
    "eslint-config-next": "0.2.4",
    "next": "16.4.4",
    "node-cron": "4.6.0",
    "tailwindcss": "^4.0.0",
    "zod": "4.6.7"
  },
  "packageManager": "npm@10.9.2"
}
