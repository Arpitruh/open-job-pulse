# ── App ─────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
NEXTAUTH_SECRET=run-openssl-rand-base64-32-and-paste-here
NEXTAUTH_URL=http://localhost:3000
ADMIN_EMAIL=your-admin@email.com

# ── Database ─────────────────────────────────────────────────
POSTGRES_USER=ojp_admin
POSTGRES_PASSWORD=dev_password
POSTGRES_DB=openjobpulse
DATABASE_URL=postgresql://ojp_admin:dev_password@localhost:5432/openjobpulse?schema=public
DIRECT_URL=postgresql://ojp_admin:dev_password@localhost:5432/openjobpulse?schema=public

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Embeddings ───────────────────────────────────────────────
# "local" uses ONNX MiniLM (384 dims) — no API key needed
# "openai" uses text-embedding-3-small (1536 dims)
EMBEDDING_ENGINE=local
EMBEDDING_DIMS=384

# ── Identity & Security ──────────────────────────────────────
# Must be exactly 32 chars for AES-256
ENCRYPTION_SECRET=12345678901234567890123456789012

# ── LinkedIn OAuth ───────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Twilio Verify (SMS + WhatsApp OTP) ───────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_WEEKLY=price_
STRIPE_PRICE_MONTHLY=price_
STRIPE_PRICE_YEARLY=price_
STRIPE_PACK_STARTER=price_
STRIPE_PACK_PRO=price_
STRIPE_PACK_POWER=price_

# ── Telegram ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=re_
RESEND_FROM_EMAIL=noreply@yourdomain.com